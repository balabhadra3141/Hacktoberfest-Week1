# ─── HOW TO CONFIGURE EcoQuest ───────────────────────────────────────────────
#
# 1. Copy this template to .env.local:
#      cp .env.example .env.local
#
# 2. .env.local is ignored by git (.gitignore rule) — your keys will never be committed.
#
# ─── FRONTEND CONFIGURATION ──────────────────────────────────────────────────

# Set to "true" to enable real AI analysis via the backend proxy.
# Leave "false" or unset to run in deterministic offline sample-data mode (no key required).
VITE_USE_GEMINI=false

# ─── BACKEND CONFIGURATION (server/server.js) ────────────────────────────────

# Google Gemini API key (starts with "AIzaSy...", obtained free from https://aistudio.google.com/app/apikey)
# The backend reads this directly from .env.local or your environment variables.
# The key stays strictly on the server and is NEVER sent to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend server port (defaults to 3001 if omitted)
PORT=3001
